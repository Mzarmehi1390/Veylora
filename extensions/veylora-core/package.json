{
  "name": "veylora-core",
  "displayName": "Veylora Core",
  "description": "First-party workspace, onboarding, diagnostics and modern defaults for Veylora IDE.",
  "version": "0.4.6",
  "publisher": "veylora",
  "license": "MIT",
  "engines": {
    "vscode": "^1.147.0"
  },
  "categories": [
    "Other",
    "Themes",
    "Visualization"
  ],
  "keywords": [
    "veylora",
    "ide",
    "dashboard",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "veylora.openDashboard",
        "title": "Veylora: Open Dashboard",
        "category": "Veylora"
      },
      {
        "command": "veylora.createWorkspaceConfig",
        "title": "Veylora: Initialize Workspace",
        "category": "Veylora"
      },
      {
        "command": "veylora.showDiagnostics",
        "title": "Veylora: Show Runtime Diagnostics",
        "category": "Veylora"
      },
      {
        "command": "veylora.openSettings",
        "title": "Veylora: Open Settings",
        "category": "Veylora"
      },
      {
        "command": "veylora.welcome",
        "title": "Veylora: Welcome",
        "category": "Veylora"
      },
      {
        "command": "veylora.workspaceHealth",
        "title": "Veylora: Workspace Health Check",
        "category": "Veylora"
      },
      {
        "command": "veylora.newProject",
        "title": "Veylora: New Project from Template",
        "category": "Veylora"
      },
      {
        "command": "veylora.applyModernProfile",
        "title": "Veylora: Apply Modern Settings Profile",
        "category": "Veylora"
      },
      {
        "command": "veylora.applyProfileToAll",
        "title": "Veylora: Apply Modern Profile to All Folders",
        "category": "Veylora"
      },
      {
        "command": "veylora.configureAI",
        "title": "Veylora: Configure AI Assistant",
        "category": "Veylora"
      },
      {
        "command": "veylora.configureTasks",
        "title": "Veylora: Configure Tasks",
        "category": "Veylora"
      }
    ],
    "keybindings": [
      {
        "command": "veylora.openDashboard",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v"
      },
      {
        "command": "veylora.showDiagnostics",
        "key": "ctrl+shift+alt+d",
        "mac": "cmd+shift+alt+d"
      },
      {
        "command": "veylora.newProject",
        "key": "ctrl+shift+alt+n",
        "mac": "cmd+shift+alt+n"
      },
      {
        "command": "veylora.workspaceHealth",
        "key": "ctrl+shift+alt+h",
        "mac": "cmd+shift+alt+h"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "veylora",
          "title": "Veylora",
          "icon": "resources/veylora.svg"
        }
      ]
    },
    "views": {
      "veylora": [
        {
          "id": "veylora.workspace",
          "name": "Workspace",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Veylora",
      "properties": {
        "veylora.workspace.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show the Veylora dashboard shortcut in the status bar."
        },
        "veylora.workspace.autoInitHint": {
          "type": "boolean",
          "default": true,
          "description": "Show a one-time hint to initialize a Veylora workspace when a folder is opened without .veylora/workspace.json."
        },
        "veylora.modernDefaults.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Prefer modern editor defaults when initializing a new Veylora workspace configuration."
        },
        "veylora.ai.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the optional local or user-configured AI assistant integration points. Off by default (privacy-first)."
        },
        "veylora.ai.provider": {
          "type": "string",
          "enum": ["none", "ollama", "openai-compatible", "custom"],
          "enumDescriptions": [
            "No AI provider",
            "Local Ollama (http://localhost:11434)",
            "Any OpenAI-compatible HTTP API",
            "Custom endpoint you control"
          ],
          "default": "none",
          "description": "Provider for optional AI features. No vendor is hard-coded; you supply the endpoint."
        },
        "veylora.ai.endpoint": {
          "type": "string",
          "default": "",
          "description": "Base URL of the AI provider (e.g. http://127.0.0.1:11434 for Ollama, or your OpenAI-compatible server)."
        },
        "veylora.ai.model": {
          "type": "string",
          "default": "",
          "description": "Model name or identifier to request from the provider."
        }
      }
    },
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/python.json"
      }
    ],
    "themes": [
      {
        "label": "Veylora Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/veylora-dark-color-theme.json"
      },
      {
        "label": "Veylora Light",
        "uiTheme": "vs",
        "path": "./themes/veylora-light-color-theme.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "veylora.gettingStarted",
        "title": "Get started with Veylora",
        "description": "Open a folder, scaffold a project, and apply privacy-first defaults.",
        "steps": [
          {
            "id": "folder",
            "title": "Open a folder",
            "description": "Veylora works inside a project folder.\n[Open Folder](command:workbench.action.files.openFolder)",
            "media": {
              "svg": "resources/veylora.svg",
              "altText": "Veylora mark"
            }
          },
          {
            "id": "scaffold",
            "title": "Scaffold a project",
            "description": "Add a Python, Node, or web starter. Files you already have are left untouched.\n[New Project](command:veylora.newProject)",
            "media": {
              "svg": "resources/veylora.svg",
              "altText": "Veylora mark"
            }
          },
          {
            "id": "profile",
            "title": "Apply modern defaults",
            "description": "Write a quieter, faster settings profile for this folder only. Telemetry is set to off.\n[Apply Profile](command:veylora.applyModernProfile)",
            "media": {
              "svg": "resources/veylora.svg",
              "altText": "Veylora mark"
            }
          },
          {
            "id": "init",
            "title": "Initialize the workspace",
            "description": "Save `.veylora/workspace.json` so health checks recognize this folder.\n[Initialize](command:veylora.createWorkspaceConfig)",
            "media": {
              "svg": "resources/veylora.svg",
              "altText": "Veylora mark"
            }
          },
          {
            "id": "dashboard",
            "title": "Open the dashboard",
            "description": "The Veylora view stays in the activity bar. Shortcut: Ctrl or Cmd+Shift+V.\n[Open Dashboard](command:veylora.openDashboard)",
            "media": {
              "svg": "resources/veylora.svg",
              "altText": "Veylora mark"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  }
}
