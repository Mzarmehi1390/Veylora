{
  "name": "veylora-core",
  "displayName": "Veylora Core",
  "description": "First-party workspace, onboarding, diagnostics and modern defaults for Veylora IDE.",
  "version": "0.4.0",
  "publisher": "veylora",
  "license": "MIT",
  "engines": {
    "vscode": "^1.147.0"
  },
  "categories": [
    "Other",
    "Themes",
    "Visualization"
  ],
  "keywords": [
    "veylora",
    "ide",
    "dashboard",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "veylora.openDashboard",
        "title": "Veylora: Open Dashboard",
        "category": "Veylora"
      },
      {
        "command": "veylora.createWorkspaceConfig",
        "title": "Veylora: Initialize Workspace",
        "category": "Veylora"
      },
      {
        "command": "veylora.showDiagnostics",
        "title": "Veylora: Show Runtime Diagnostics",
        "category": "Veylora"
      },
      {
        "command": "veylora.openSettings",
        "title": "Veylora: Open Settings",
        "category": "Veylora"
      },
      {
        "command": "veylora.welcome",
        "title": "Veylora: Welcome",
        "category": "Veylora"
      },
      {
        "command": "veylora.workspaceHealth",
        "title": "Veylora: Workspace Health Check",
        "category": "Veylora"
      },
      {
        "command": "veylora.newProject",
        "title": "Veylora: New Project from Template",
        "category": "Veylora"
      }
    ],
    "keybindings": [
      {
        "command": "veylora.openDashboard",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v"
      },
      {
        "command": "veylora.showDiagnostics",
        "key": "ctrl+shift+alt+d",
        "mac": "cmd+shift+alt+d"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "veylora",
          "title": "Veylora",
          "icon": "resources/veylora.svg"
        }
      ]
    },
    "views": {
      "veylora": [
        {
          "id": "veylora.workspace",
          "name": "Workspace",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Veylora",
      "properties": {
        "veylora.workspace.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show the Veylora dashboard shortcut in the status bar."
        },
        "veylora.workspace.autoInitHint": {
          "type": "boolean",
          "default": true,
          "description": "Show a one-time hint to initialize a Veylora workspace when a folder is opened without .veylora/workspace.json."
        },
        "veylora.modernDefaults.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Prefer modern editor defaults when initializing a new Veylora workspace configuration."
        }
      }
    },
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/python.json"
      }
    ],
    "themes": [
      {
        "label": "Veylora Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/veylora-dark-color-theme.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  }
}
