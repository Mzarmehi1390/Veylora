{
  "name": "veylora",
  "private": true,
  "version": "0.2.0",
  "description": "A Veylora-branded desktop IDE built on the open-source Code - OSS workbench.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev:watch": "node scripts/watch.mjs",
    "dev:launch": "node scripts/launch.mjs",
    "brand": "node scripts/apply-branding.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm --prefix extensions/veylora-core run compile",
    "ci": "npm run test && npm run typecheck"
  }
}
